# Local development only. Copy to .env and choose a password (letters/digits).
POSTGRES_USER=finance_copilot
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=finance_copilot
POSTGRES_PORT=5432
# Used when running Python on the host; URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://finance_copilot:replace_with_local_password@127.0.0.1:5432/finance_copilot
# Tests create and drop an isolated random schema, never your application tables.
TEST_DATABASE_URL=postgresql+psycopg://finance_copilot:replace_with_local_password@127.0.0.1:5432/finance_copilot
# Loopback by default. Set to 0.0.0.0 ONLY for trusted LAN device development.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000

# Open Finance / Pluggy. Backend only: never copy these values into the web client.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# Copilot (LLM). Backend only.
# Provider: "ollama" (default; a model running on this machine, free, data stays local)
# or "anthropic" (hosted; needs ANTHROPIC_API_KEY and sends questions and results to the API).
COPILOT_PROVIDER=ollama
# Optional. Defaults: llama3.1:8b for ollama, claude-opus-5-5 for anthropic.
# For ollama it must be a model with tool calling, already pulled: ollama pull <model>
COPILOT_MODEL=
# Ollama only. Default http://127.0.0.1:11434
OLLAMA_BASE_URL=
# Anthropic only: never expose the key to the web client.
ANTHROPIC_API_KEY=
